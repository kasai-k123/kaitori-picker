---
import { applicationLink, returnLabel, type Course, data } from '../lib/data';
interface Props { course: Course }
const { course } = Astro.props;
const service = data.serviceRecords.find(s => s.id === course.serviceId)!;
---
<article class="course-card" data-course-id={course.id}>
  <div class="card-top"><span class="status" data-status>条件に合う</span><span class="small">{course.serviceId === 'netoff' ? 'コース別' : '宅配買取'}</span></div>
  <h3>{course.name}</h3><p>{course.summary}</p>
  <dl><dt>代金の受取</dt><dd>{course.payout.display}</dd><dt>査定後の返送料</dt><dd>{returnLabel(course)}</dd></dl>
  <p class="condition">{course.fees.notes}</p>
  <ul class="reasons" data-reasons hidden></ul>
  <div class="card-actions"><a href={`${service.detailPath}#${course.courseId}`}>条件を詳しく見る <span aria-hidden="true">→</span></a><a class="button" href={applicationLink(course).url} data-outbound={course.id}>公式サイトで申し込む <span aria-hidden="true">↗</span></a></div>
</article>
