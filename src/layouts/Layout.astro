---
import '../styles/global.css';
import { data } from '../lib/data';
interface Props { title: string; description?: string; noindex?: boolean; serviceId?: string }
const { title, description = '本・ゲーム・ブランド品などの宅配買取5社を、申込点数・送料・代金の受取方法で比較できます。', noindex = false, serviceId = '' } = Astro.props;
const canonical = __SITE_URL_CONFIGURED__ ? new URL(Astro.url.pathname, Astro.site) : null;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {data.site.name}</title><meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}<meta name="robots" content={noindex || !__SITE_URL_CONFIGURED__ ? 'noindex, follow' : 'index, follow'} />
    <meta property="og:type" content="website" /><meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={`${title} | ${data.site.name}`} /><meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}<meta property="og:site_name" content={data.site.name} />
    <meta name="twitter:card" content="summary" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body data-service-id={serviceId}>
    <a class="skip" href="#main">本文へ</a>
    <header><a class="brand" href="/"><span aria-hidden="true">▣</span> 宅配買取えらび</a><nav aria-label="メイン"><a href="/">比較する</a><a href="/methodology/">比較の基準</a></nav></header>
    <main id="main"><slot /></main>
    <footer><a class="brand" href="/">宅配買取えらび</a><p>情報確認日：{data.asOf}</p><nav aria-label="フッター"><a href="/methodology/">比較の基準・出典</a><a href="/privacy/">プライバシーポリシー</a></nav></footer>
    <script>import '../scripts/analytics';</script>
  </body>
</html>
