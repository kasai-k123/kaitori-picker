---
import Layout from '../../layouts/Layout.astro';
import { data, courses, categories, applicationLink, returnLabel, boxLabel } from '../../lib/data';
export function getStaticPaths() { return data.serviceRecords.map(service => ({ params: { id: service.id }, props: { service } })); }
const { service } = Astro.props;
const selected = courses.filter(c => c.serviceId === service.id);
---
<Layout title={`${service.name}の条件・返送料`} serviceId={service.id}>
  <div class="page-heading"><a href="/">← 比較に戻る</a><p class="eyebrow">サービスの詳しい条件</p><h1>{service.name}</h1><p>確認日：{data.asOf}</p>{selected.length > 1 && <nav aria-label="コース"><a href="#books-games">本・ゲーム買取</a><a href="#brand-general">ブランド・総合買取</a></nav>}</div>
  {selected.map(course => <section class="detail" id={course.courseId}>
    <h2>{course.name}</h2><p>{course.summary}</p>
    <dl class="detail-facts"><dt>代金の受取</dt><dd>{course.payout.display}</dd><dt>発送送料</dt><dd>{course.fees.outboundShipping === 'free' ? '無料' : '初回無料。2回目以降は査定額による送料充当あり'}</dd><dt>査定後の返送料</dt><dd>{returnLabel(course)}</dd><dt>梱包用の箱</dt><dd>{boxLabel(course)}</dd><dt>一部だけ返送</dt><dd>{course.approval.partialReturn === null ? '要確認' : course.approval.partialReturn ? '可能' : '不可'}</dd><dt>自動承認の選択</dt><dd>{course.approval.autoApprovalAvailable === null ? '選択の有無は要確認' : course.approval.autoApprovalAvailable ? 'あり。自動承認では返却不可' : 'なし'}</dd></dl>
    <p class="notice">{course.fees.notes}</p><p>返送を希望する可能性がある場合は、査定結果を確認してから承認する方法を選んでください。</p>
    <h3>対象カテゴリと最低点数</h3><div class="table-scroll"><table><thead><tr><th scope="col">カテゴリ</th><th scope="col">基本条件</th><th scope="col">補足</th></tr></thead><tbody>{categories.map(([id, label]) => { const rule = course.categories[id]; return <tr><th scope="row">{label}</th><td>{rule.state === 'no' ? '対象外' : rule.state === 'unknown' ? '確認が必要' : rule.minItems === null ? '対象・最低点数は要確認' : `${rule.minItems}点から`}</td><td>{rule.note || '—'}</td></tr>; })}</tbody></table></div>
    <h3>利用条件・注意点</h3><ul>{course.restrictions.map(text => <li>{text}</li>)}</ul>
    <a class="button" href={applicationLink(course).url} data-outbound={course.id}>公式サイトで申し込む ↗</a>
    <h3>公式の出典</h3><ul class="sources">{data.sources.filter(source => course.sourceIds.includes(source.id)).map(source => <li><a href={source.url}>{source.label}</a><span class="small">（確認日：{source.checkedAt}）</span></li>)}</ul>
  </section>)}
</Layout>
